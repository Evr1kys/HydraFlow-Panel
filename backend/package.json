{
  "name": "hydraflow-panel-backend",
  "version": "2.0.0",
  "description": "HydraFlow Panel backend - NestJS + Prisma + PostgreSQL",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node src/seed.ts",
    "test": "jest --passWithNoTests",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.0.0",
    "@grammyjs/menu": "^1.3.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.7.0",
    "@prisma/client": "^5.8.0",
    "@simplewebauthn/server": "14.0.2",
    "@types/qrcode": "^1.5.6",
    "arctic": "^3.7.0",
    "axios": "1.20.0",
    "bcrypt": "6.0.0",
    "bullmq": "5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "0.15.1",
    "grammy": "^1.42.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.3.2",
    "nanoid": "3.3.19",
    "nodemailer": "10.0.10",
    "otplib": "^13.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "undici": "6.28.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.23",
    "@types/passport-jwt": "^3.0.13",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "prisma": "^5.8.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "axios": "1.20.0"
  }
}
