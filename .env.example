# Generate secrets before first start. Do not commit the populated .env file.
# Example generators:
#   openssl rand -hex 32      # DB_PASSWORD (URL-safe)
#   openssl rand -base64 64   # JWT_SECRET
#   openssl rand -base64 64   # CREDENTIALS_ENCRYPTION_KEY
#   openssl rand -base64 36   # ADMIN_PASSWORD

NODE_ENV=production
DB_PASSWORD=
JWT_SECRET=
CREDENTIALS_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

SERVER_PUBLIC_IP=
PUBLIC_BASE_URL=https://panel.example.com
CORS_ORIGIN=https://panel.example.com
SWAGGER_ENABLED=false

REDIS_URL=redis://redis:6379

# HydraFlow Agent transport. TLS verification is never disabled.
# A node-specific CA may be supplied during registration; these paths provide
# global CA and optional mTLS credentials mounted read-only into the container.
NODE_TLS_SECRETS_DIR=./secrets
NODE_AGENT_CA_CERT_PATH=/run/secrets/hydraflow/agent-ca.pem
NODE_CLIENT_CERT_PATH=
NODE_CLIENT_KEY_PATH=

# Private Agent IPs are blocked unless explicitly listed here. Cloud metadata
# addresses remain blocked even when listed. Prefer public DNS names or a VPN
# network with exact IP allowlisting.
NODE_AGENT_PRIVATE_ALLOWLIST=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_ID=
BOT_SHOP_ENABLED=false
BOT_SHOP_MODE=standalone

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRYPTOBOT_TOKEN=
HELEKET_MERCHANT_ID=
HELEKET_API_KEY=
HELEKET_API_BASE=https://api.heleket.com
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_CALLBACK_URL=

WEBAUTHN_RP_NAME=HydraFlow Panel
WEBAUTHN_RP_ID=panel.example.com
WEBAUTHN_ORIGIN=https://panel.example.com

TELEGRAM_OAUTH_BOT_TOKEN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
